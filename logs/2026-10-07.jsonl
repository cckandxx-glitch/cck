 d.name, text: `检测到 ${d.title ? `「${d.title}」(${d.name})` : d.name} 在运行，AI 已自动下线。` }; bc('bar', {}); }\n    else if (type === 'autoon') { bar = null; bc('bar', {}); }\n    bc('state', {})"}
